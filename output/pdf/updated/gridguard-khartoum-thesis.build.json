  "figure_metadata": {
    "workflow": {
      "number": "3.1",
      "title": "Research workflow",
      "path": "docs/assets/focused-study/research-workflow.png",
      "explanation": "Common synthetic inputs support matched control evaluation. Demand prediction is evaluated separately; forecasts are not fed into the controllers."
    },
    "overview": {
      "number": "4.1",
      "title": "Desktop overview",
      "path": "docs/assets/current-app-screenshots/overview.png",
      "explanation": "The seven-locality map and saved evidence support offline inspection of synthetic scenarios."
    },
    "live": {
      "number": "4.2",
      "title": "Live Scenario inspection",
      "path": "docs/assets/current-app-screenshots/live-ppo.png",
      "explanation": "The validation-selected seed-8111 checkpoint-2500 policy runs one matched episode. This demonstration is distinct from the frozen five-run results."
    },
    "outcomes": {
      "number": "5.1",
      "title": "Main controller outcomes",
      "path": "docs/assets/focused-study/controller-outcomes.png",
      "explanation": "Results use 960 fresh matched test conditions. PPO is the equal-weight mean of five validation-selected policies. Each panel has its own units."
    },
    "intervals": {
      "number": "5.2",
      "title": "Paired PPO effects against Constrained Optimization",
      "path": "docs/assets/focused-study/paired-effects.png",
      "explanation": "Panels show critical interruption, Jain fairness, utilization and daily reward. Effects subtract the optimizer from PPO; intervals have 97.5% coverage for the two primary comparisons. Percentage outcomes use percentage-point differences."
    },
    "training": {
      "number": "5.3",
      "title": "Validation learning trajectories",
      "path": "docs/assets/focused-study/training-curves.png",
      "explanation": "Top: daily reward. Middle: Jain service fairness. Bottom: supply utilization. Each curve represents one training seed on fixed validation scenarios. Dots mark selected checkpoints; the dashed line marks iteration 600. These are not test results."
    },
    "diagnostics": {
      "number": "5.4",
      "title": "TensorBoard training diagnostics",
      "path": "docs/assets/focused-study/tensorboard-diagnostics.png",
      "explanation": "Rollout reward, policy loss, value loss, policy entropy, approximate KL and clipped fraction are recorded every 25 iterations without smoothing. The thick line is the five-run mean and shading is one sample standard deviation, not a confidence interval."
    },
    "variance": {
      "number": "5.5",
      "title": "Between-run validation variance",
      "path": "docs/assets/focused-study/training-variance.png",
      "explanation": "Panels show sample variance of run-mean daily reward, fairness and utilization at 31 matched checkpoints. The denominator is four. Units are squared score or squared percentage points; this is not within-scenario variance or critic explained variance."
    },
    "forecast": {
      "number": "5.6",
      "title": "Held-out forecasting error",
      "path": "docs/assets/focused-study/forecast-errors.png",
      "explanation": "MAE and RMSE compare locality-sector and system-total targets on 320 held-out synthetic traces. Forecast evaluation is separate from the controller comparison."
    }
  },
